# Copy to .env and fill in. Variable names match src/utils/config.js.

# --- Required (the app throws at startup if any are missing) ---
DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/careermate
JWT_KEY=replace-with-a-long-random-secret
S3_BUCKET=your-bucket-name

# --- Optional (defaults shown) ---
PORT=3000
LOG_LEVEL=info
AWS_REGION=ap-southeast-2

# Public CloudFront domain serving avatar/* (no protocol). Leave unset to disable avatarUrl.
# CLOUDFRONT_DOMAIN=dxxxxxxxxxxxx.cloudfront.net

# NODE_ENV is set by the npm scripts (dev/start); only set it here if you run node directly.
# NODE_ENV=development

# Rate limiter settings. Env values are strings and config.js does not cast them,
# which express-rate-limit rejects (ERR_ERL_WINDOW_MS). Keep these unset to use the
# numeric defaults (15 min window, 100 requests) until config.js casts them.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_LIMIT=100

# --- AWS credentials ---
# Not read by config.js; picked up by the AWS SDK default credential chain.
# Use for local development only. If deployed to Elastic Beanstalk, use the instance profile role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
